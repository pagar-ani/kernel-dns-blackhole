<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<YogaDnsProfile file_format="1" product_id="1" product_min_version="127000">
	<!--
	CRITICAL ENGINE INVARIANT:
	ignore_rule_if_interface_down="1" is the master switch.
	When WireGuard is active, Rule 02 matches the interface and routes queries to Corporate DNS.
	When WireGuard disconnects, Rule 02 is automatically SKIPPED by YogaDNS,
	falling through to Rule 03 (Cloudflare DoH) instantly. Zero corporate DNS leakage.
	-->
	<Settings ignore_rule_if_interface_down="1" blockTcpPort53="1" clearDnsCache="1" ttlMin="0" ttlMax="2147483647" captivePortalDetection="0" interceptOthers="0">
		<DnsChecker testTarget="iana.org" testsPerTime="15" importUrls="https://yogadns.com/resolvers/resolvers.md
https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/public-resolvers.md
https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/relays.md
" />
	</Settings>

	<!-- Tier 01: Domain Sinkhole Blocklist (3.6M domains dropped to 0.0.0.0 via optimized_hosts.txt) -->
	<Rule name="01-Sinkhole" enabled="1" dnssec_local_validation="0" dnssec_reject_unsigned="0" block_return_zero_ip="1" hostnames="file://optimized_hosts.txt
" action="block" action_id="0" interface_id="" interface_id_type="id" interface_name="" />

	<!-- Tier 02: Conditional Tunnel (Active ONLY when WireGuard interface is UP) -->
	<!-- Replace interface_id with your WireGuard interface name (e.g. wg0, wg-office) -->
	<Rule name="02-WireGuard-Corporate" enabled="1" dnssec_local_validation="0" dnssec_reject_unsigned="0" hostnames="*" action="process_pool" action_id="1953" interface_id="YOUR_WIREGUARD_INTERFACE_NAME" interface_id_type="name" />

	<!-- Tier 03: Fallback / Default Public Resolver (Active when WireGuard is DOWN) -->
	<Rule name="03-Default-Public-Failover" enabled="1" dnssec_local_validation="0" dnssec_reject_unsigned="0" hostnames="*" action="process_pool" action_id="1954" interface_id="" interface_id_type="id" interface_name="" />

	<!-- DNS Server Pools -->
	<DnsPool id="1953" name="Corporate-Pool" type="redundancy" redundancy_test_host="iana.org" redundancy_recheck_delay="60">
		<DnsServer id="1000" />
		<DnsServer id="1001" />
	</DnsPool>
	<DnsPool id="1954" name="Public-Pool" type="redundancy" redundancy_test_host="iana.org" redundancy_recheck_delay="60">
		<DnsServer id="1432" />
		<DnsServer id="1433" />
	</DnsPool>

	<!-- Corporate DNS Servers: REPLACE WITH YOUR ACTUAL CORPORATE DNS IPs -->
	<!-- Note: Keep plain UDP only. Never enable TCP/DNSSEC internally to avoid handshake penalties -->
	<DnsServer id="1000" name="Corporate-Primary-IPv4" protocol="plain" af="2" ip="YOUR_CORPORATE_DNS_IPV4" plain_use_tcp="0" />
	<DnsServer id="1001" name="Corporate-Secondary-IPv6" protocol="plain" af="23" ip="YOUR_CORPORATE_DNS_IPV6" plain_use_tcp="0" />

	<!-- Public Secure DNS: Cloudflare 1.1.1.2 / 1.0.0.2 Security Filter (DoH Encrypted) -->
	<DnsServer id="1432" name="Cloudflare-Security-DoH" protocol="doh" af="2" ip="1.0.0.2" dnssec_supported="1" doh_host_name="1.0.0.2" doh_path="/dns-query" />
	<DnsServer id="1433" name="Cloudflare-Security-DoH-IPv6" protocol="doh" af="23" ip="2606:4700:4700::1112" dnssec_supported="1" doh_host_name="[2606:4700:4700::1112]:443" doh_path="/dns-query" />
</YogaDnsProfile>
